# /etc/ampairs/secrets.env — production secrets template
#
# Copy this file to /etc/ampairs/secrets.env on the production server.
# Set real values, then lock down permissions:
#
#   sudo chown root:ampairs /etc/ampairs/secrets.env
#   sudo chmod 640 /etc/ampairs/secrets.env
#
# This file is loaded by systemd EnvironmentFile= — it is NOT sourced by bash,
# so no export keyword and no shell quoting around values that contain spaces.
#
# NEVER commit the real /etc/ampairs/secrets.env to git.

# Database
DB_URL=jdbc:postgresql://HOST:5432/ampairs_prod
DB_USERNAME=ampairs_user
DB_PASSWORD=CHANGE_ME

# JWT (generate with: openssl rand -hex 64)
JWT_SECRET=CHANGE_ME

# Google reCAPTCHA
RECAPTCHA_SECRET_KEY=CHANGE_ME

# AWS (if using S3/SNS)
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# Firebase (path to the downloaded service account JSON)
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=/opt/ampairs/production/keys/ampairs-firebase-adminsdk.json
